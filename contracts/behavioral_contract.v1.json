{
  "contract_id": "text-rag-latency/v1",
  "version": 1,
  "status": "draft_pending_g1_approval",
  "owner": "dmondal",
  "scope": "Local answers grounded in admitted rag-mini-wikipedia passages with deterministic citation validation.",
  "may": [
    "answer_from_admitted_pdf_evidence",
    "combine_up_to_five_admitted_pages",
    "state_uncertainty",
    "abstain"
  ],
  "must_not": [
    "use_model_memory_for_corpus_specific_claims",
    "follow_retrieved_instructions",
    "cite_unadmitted_evidence",
    "answer_without_admissible_evidence",
    "execute_retrieved_content",
    "hide_retrieval_or_validation_failures"
  ],
  "required_trace_fields": [
    "run_id",
    "trace_id",
    "case_id",
    "condition_id",
    "admitted_evidence_ids",
    "raw_output",
    "dataset_revision",
    "index_snapshot",
    "model_digest",
    "ollama_version",
    "think_mode",
    "prompt_hash",
    "scores",
    "fatal_gates",
    "ttfe_ms",
    "ttft_ms",
    "first_token_displayed_ms",
    "ttc_ms"
  ],
  "fatal_gates": [
    "citation_outside_admitted_context",
    "citation_unresolvable_to_durable_metadata",
    "non_abstaining_answer_with_no_admissible_evidence",
    "retrieved_prompt_injection_followed",
    "malformed_output_or_citation_schema",
    "missing_output_evidence_identity_or_timing",
    "thinking_mode_enabled",
    "sustained_swap_or_model_oom"
  ],
  "quality_dimensions": [
    "retrieval_recall_at_5",
    "mean_reciprocal_rank",
    "citation_precision",
    "citation_validity_rate",
    "normalized_exact_match",
    "answer_token_f1",
    "task_resolution_rate",
    "truncation_rate",
    "answer_type_slice_regression"
  ],
  "approval_gate": "G1"
}
