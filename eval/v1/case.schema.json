{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Text RAG evaluation case v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "source_row_id",
    "question",
    "reference_answer",
    "answer_type",
    "gold_evidence_ids",
    "support_quote",
    "review_method",
    "reviewer",
    "review_rationale",
    "expected_abstention",
    "verification_status",
    "holdout"
  ],
  "properties": {
    "case_id": {"type": "string", "pattern": "^eval-v1-[0-9]{2}$"},
    "source_row_id": {"type": "integer", "minimum": 0},
    "question": {"type": "string", "minLength": 1},
    "reference_answer": {"type": "string", "minLength": 1},
    "answer_type": {"enum": ["boolean", "numeric_or_date", "short_phrase", "free_form"]},
    "gold_evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
      },
    "support_quote": {"type": "string", "minLength": 1},
    "review_method": {"const": "codex_assisted_manual_review"},
    "reviewer": {"type": "string", "minLength": 1},
    "review_rationale": {"type": "string", "minLength": 1},
    "expected_abstention": {"type": "boolean"},
    "verification_status": {"const": "manually_verified"},
    "holdout": {"type": "boolean"}
  }
}
